            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{http_route=~\"$rota\", http_route!~\"/chaos|/health\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{http_route=~\"$rota\", http_route!~\"/chaos|/health\"}[$__rate_interval]))",
